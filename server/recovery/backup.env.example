# Copy to /etc/venikoff/backup.env, owner root, mode 0600.
# Populate through secure server configuration, never commit real values.
# systemd EnvironmentFile syntax: no shell expansion.
RESTIC_REPOSITORY=s3:https://REPLACE-ENDPOINT/REPLACE-BUCKET/venikoff
RESTIC_PASSWORD_FILE=/etc/venikoff/restic-password
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
VENIKOFF_ROOT=/opt/venikoff
PB_BACKUPS_DIR=/opt/venikoff/pb/pb_data/backups
# Daily native ZIP + 2 hours margin. Reduce to 7200 after hourly native backups.
MAX_BACKUP_AGE_SECONDS=93600
# Hourly export does not increase the freshness of a daily native ZIP.
