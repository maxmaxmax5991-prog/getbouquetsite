[Unit]
Description=Moscow weather for subtle storefront snow
After=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/venikoff/bin/update-weather.py
TimeoutStartSec=25
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/venikoff/backups/weather /opt/venikoff/site
